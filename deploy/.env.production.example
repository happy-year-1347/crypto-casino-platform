APP_NAME=ViperPRO
APP_ENV=production
# generate a NEW key on the server: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_DEMO=false
APP_URL=https://YOUR_DOMAIN
VITE_BASE_URL=/
LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=casino
DB_USERNAME=casino
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@YOUR_DOMAIN
MAIL_FROM_NAME="${APP_NAME}"

# websockets (only if you enable live features; the current build does not need it)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=6001
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# generate on the server: php artisan jwt:secret --show
JWT_SECRET=
JWT_TTL=6000000

GOOGLE_RECAPTCHA_ENABLE=
GOOGLE_RECAPTCHA_SITE_KEY=
GOOGLE_RECAPTCHA_SECRET_KEY=

# social login (leave empty to disable)
GOOGLE_API_KEY=
GOOGLE_API_SECRET=
GOOGLE_REDIRECT="${APP_URL}/auth/callback/google"
FACEBOOK_API_KEY=
FACEBOOK_API_SECRET=
FACEBOOK_REDIRECT="${APP_URL}/auth/callback/facebook"

# legacy gateways, kept off
STRIPE_ENABLED=off
STRIPE_SUBSCRIPTION_ENABLED=off
PIX_ENABLED=off
STRIPE_BASE_URI=https://api.stripe.com
STRIPE_WEBHOOK_URI="${APP_URL}/webhooks/stripe"
STRIPE_WEBHOOK_SECRET=
STRIPE_KEY=
STRIPE_SECRET=

# NOWPayments credentials are set in Admin > Financial > Payment Gateway.
# Leave this empty in production (it only points the client at a test mock).
NOWPAYMENTS_API_URL=
